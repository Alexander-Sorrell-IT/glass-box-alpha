# WalletConnect / Reown project id — https://cloud.reown.com (free)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Deployed site origin — required for share-card OG images to unfurl on X.
# Leave as localhost for local dev; set to the real origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mantle RPC (defaults to the public endpoint if unset)
NEXT_PUBLIC_MANTLE_RPC=https://rpc.mantle.xyz
