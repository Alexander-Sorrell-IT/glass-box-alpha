# Mantle network
MANTLE_MAINNET_RPC=https://rpc.mantle.xyz
MANTLE_SEPOLIA_RPC=https://rpc.sepolia.mantle.xyz
MANTLE_EXPLORER_API_KEY=  # from https://mantlescan.xyz/myapikey
DEPLOYER_PRIVATE_KEY=     # the wallet that deploys + funds the agents

# Live runner (python -m agents.settler.live) — see docs/mainnet-runbook.md
GLASSBOX_RPC_URL=https://rpc.sepolia.mantle.xyz  # chain the settler signs against
SETTLER_PRIVATE_KEY=      # must be RoundState's settler (+ AgentExecutor's owner if trading); falls back to DEPLOYER_PRIVATE_KEY
ROUND_STATE_ADDRESS=0xe016C12d1D42cc2E4ECaaCE2B0fd5058cC984Ea5       # Sepolia (5003) deploy
REASONING_ANCHOR_ADDRESS=0xB0319b2e88d95B2d7Ce706feC7E2799d9b93353d  # Sepolia (5003) deploy
AGENT_EXECUTOR_ADDRESS=   # optional — unset skips the trade-execution leg
MANTLE_RPC_URL=           # first-party provenance read (mantle-rpc:live@block=N); unset = honestly 'unavailable'
# LLAMA_PRICE_URL=        # test hook for the settlement price read; leave unset in real runs

# LLM backend (DeepSeek via OpenAI-compatible API)
DEEPSEEK_API_KEY=         # https://platform.deepseek.com → API Keys
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro  # intended thinking model (streams reasoning_content) — NOT verified live in this build; the golden receipt tests pin 'deepseek-reasoner'
# DEEPSEEK_MODEL=deepseek-v4-flash   # faster, cheaper V4 variant

# Sponsor data APIs
NANSEN_API_KEY=           # https://docs.nansen.ai
ELFA_API_KEY=             # https://www.elfa.ai/api
# SURF_API_KEY=           # if accessible

# ERC-8004 registries (Mantle Mainnet)
ERC8004_IDENTITY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63

# Frontend
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=  # from https://cloud.walletconnect.com
NEXT_PUBLIC_MANTLE_RPC=https://rpc.mantle.xyz

# Optional: paid amplification budget per Round 8 strategy
# DESIGNER_BUDGET=800     # flat-fee Figma sprint
# KOL_BUDGET=300          # 1 Mantle-ecosystem micro-influencer

# Trading seed (real on-chain)
SEED_CAPITAL_USDC=200     # start small, max $500
