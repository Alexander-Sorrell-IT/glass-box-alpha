# Mantle network
MANTLE_MAINNET_RPC=https://rpc.mantle.xyz
MANTLE_SEPOLIA_RPC=https://rpc.sepolia.mantle.xyz
MANTLE_EXPLORER_API_KEY=  # from https://mantlescan.xyz/myapikey
DEPLOYER_PRIVATE_KEY=     # the wallet that deploys + funds the agents

# LLM backend
ANTHROPIC_API_KEY=        # Claude Sonnet 4.6 default
ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_API_KEY=         # optional fallback

# Sponsor data APIs
NANSEN_API_KEY=           # https://docs.nansen.ai
ELFA_API_KEY=             # https://www.elfa.ai/api
# SURF_API_KEY=           # if accessible

# ERC-8004 registries (Mantle Mainnet)
ERC8004_IDENTITY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63

# Frontend
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=  # from https://cloud.walletconnect.com
NEXT_PUBLIC_MANTLE_RPC=https://rpc.mantle.xyz

# Optional: paid amplification budget per Round 8 strategy
# DESIGNER_BUDGET=800     # flat-fee Figma sprint
# KOL_BUDGET=300          # 1 Mantle-ecosystem micro-influencer

# Trading seed (real on-chain)
SEED_CAPITAL_USDC=200     # start small, max $500
